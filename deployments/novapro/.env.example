# NovaPro Plane — copy to .env and fill in every "change-me".
# Generate secrets with: openssl rand -hex 32

# --- Where Plane is reached -------------------------------------------------------------
# Full URL people open, including the port; used for links in emails, digests and webhooks.
WEB_URL=http://truenas.local:8080
PLANE_HTTP_PORT=8080
PLANE_HTTPS_PORT=8443
# Caddy site address. ":80" serves plain HTTP (put your own TLS proxy in front).
# For automatic HTTPS use your domain (e.g. plane.example.com) with a DNS challenge provider,
# because ACME HTTP challenges need public port 80.
SITE_ADDRESS=:80
APP_DOMAIN=localhost
CERT_EMAIL=
CERT_ACME_DNS=

# --- Images (built from AKolenda/plane by .github/workflows/novapro-images.yml) ----------
PLANE_IMAGE_REGISTRY=ghcr.io/akolenda
PLANE_IMAGE_TAG=latest
# "missing" pulls once; "always" pulls on every `up`
PLANE_PULL_POLICY=missing

# --- Secrets --------------------------------------------------------------------------
SECRET_KEY=change-me
LIVE_SERVER_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
AWS_SECRET_ACCESS_KEY=change-me

# --- Postgres (bundled by default) -------------------------------------------------------
# External: PLANE_BUNDLED_DB_REPLICAS=0 and set DATABASE_URL (and PGHOST for the backups).
PLANE_BUNDLED_DB_REPLICAS=1
POSTGRES_USER=plane
POSTGRES_DB=plane
# DATABASE_URL=postgresql://plane:secret@db.lan:5432/plane
# PGHOST=db.lan
# Bind the data to a dataset instead of a Docker volume, e.g. /mnt/tank/apps/plane/pgdata
# PLANE_PGDATA=/mnt/tank/apps/plane/pgdata

# --- Valkey / Redis (bundled by default) -------------------------------------------------
# External: PLANE_BUNDLED_REDIS_REPLICAS=0, REDIS_URL=redis://cache.lan:6379/, REDIS_HOST=cache.lan
PLANE_BUNDLED_REDIS_REPLICAS=1

# --- RabbitMQ (bundled by default) -------------------------------------------------------
# External: PLANE_BUNDLED_MQ_REPLICAS=0 and AMQP_URL=amqp://user:pass@mq.lan:5672/plane
PLANE_BUNDLED_MQ_REPLICAS=1
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=plane

# --- Object storage (bundled MinIO by default) -------------------------------------------
# External S3 / MinIO: PLANE_BUNDLED_STORAGE_REPLICAS=0, USE_MINIO=0 and set the endpoint.
PLANE_BUNDLED_STORAGE_REPLICAS=1
USE_MINIO=1
AWS_ACCESS_KEY_ID=plane-access-key
AWS_S3_BUCKET_NAME=uploads
AWS_REGION=
# AWS_S3_ENDPOINT_URL=https://s3.lan:9000
# PLANE_UPLOADS=/mnt/tank/apps/plane/uploads
FILE_SIZE_LIMIT=5242880

# --- Backups (pg_dump every BACKUP_INTERVAL_HOURS into PLANE_BACKUP_DIR) -------------------
PLANE_BACKUP_REPLICAS=1
PLANE_BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# --- API, webhooks -----------------------------------------------------------------------
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
# Internal hosts outbound webhooks may call (comma-separated), e.g. notifier,192.168.1.20
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOWED_IPS=

# --- GitHub integration (docs/github-integration.md) -----------------------------------
GITHUB_INTEGRATION_HOST_URL=https://github.com
GITHUB_INTEGRATION_API_URL=
GITHUB_INTEGRATION_WEBHOOK_BASE_URL=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_INTEGRATION_OAUTH_CLIENT_ID=
GITHUB_INTEGRATION_OAUTH_CLIENT_SECRET=

# --- Transcript importer (off until configured) ------------------------------------------
TRANSCRIPT_IMPORTER_REPLICAS=0
# Folder on the host (e.g. the TrueNAS share's dataset) holding call transcripts
TRANSCRIPT_HOST_DIR=./transcripts
# Personal access token of a project member (Profile settings > Personal access tokens)
TRANSCRIPT_PLANE_API_KEY=
TRANSCRIPT_WORKSPACE_SLUG=
TRANSCRIPT_PROJECT=
TRANSCRIPT_LABELS=transcript
# name=email pairs, e.g. dana=dana@novapro.ca,Sam Lee=sam@novapro.ca
TRANSCRIPT_ASSIGNEES=
TRANSCRIPT_SOURCE_URL_BASE=
TRANSCRIPT_POLL_SECONDS=30
TRANSCRIPT_SETTLE_SECONDS=10
# Optional OpenAI-compatible LLM for transcripts without action-item markers
TRANSCRIPT_LLM_BASE_URL=
TRANSCRIPT_LLM_MODEL=llama3.1
TRANSCRIPT_LLM_API_KEY=

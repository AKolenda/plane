FROM node:26-alpine

RUN apk add --no-cache libc6-compat
# Set working directory
WORKDIR /app

COPY . .
RUN npm install -g corepack@latest && corepack enable pnpm && pnpm add -g turbo
RUN pnpm install

EXPOSE 3000
VOLUME [ "/app/node_modules", "/app/web/node_modules" ]
CMD ["pnpm", "dev", "--filter=web"]
